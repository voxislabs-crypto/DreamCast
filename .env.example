# EdgeDream – Environment Variables
# Copy this file to .env.local and fill in your values

# ── LLM Narration ───────────────────────────────────────────────────
# Primary: OpenAI-compatible endpoint (works with OpenAI or xAI Grok)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
NARRATION_MODEL=gpt-4o

# ── Video Generation ────────────────────────────────────────────────
# Primary: Replicate (supports Kling, Luma, and other video models)
REPLICATE_API_TOKEN=r8_...
VIDEO_MODEL_VERSION=your-model-version-here

# Fallback: Runway Gen-3 API
RUNWAY_API_KEY=rw_...

# ── Session Storage ──────────────────────────────────────────────────
# Supabase (Postgres + realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Authentication ───────────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-to-a-random-string
NEXTAUTH_URL=http://localhost:3000

# ── Subscriptions / Billing ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Plan price IDs from your Stripe dashboard
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_ULTRA=price_...

# ── Content Moderation ───────────────────────────────────────────────
# OpenAI moderation endpoint is used by default (no extra key needed).
# Set to "true" to enable strict mode (blocks any borderline content).
CONTENT_MODERATION_STRICT=true
