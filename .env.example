# EdgeDream environment variables
# Copy this file to .env.local and fill in your values.

# LLM narration
# Option A - OpenAI:
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   NARRATION_MODEL=gpt-4o
#
# Option B - xAI Grok:
#   OPENAI_API_KEY=xai-...
#   OPENAI_BASE_URL=https://api.x.ai/v1
#   NARRATION_MODEL=grok-3-beta
#
# Option C - DeepInfra / DeepSeek-class models:
#   OPENAI_API_KEY=your-deepinfra-token
#   NARRATION_BASE_URL=https://api.deepinfra.com/v1/openai
#   NARRATION_MODEL=deepseek-ai/DeepSeek-V3
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
NARRATION_BASE_URL=
NARRATION_MODEL=gpt-4o

# Video generation
# Cheapest path: SiliconFlow video submit/status API
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE=https://api.siliconflow.com/v1
SILICONFLOW_VIDEO_MODEL=Wan-AI/Wan2.2-I2V-A14B

# Fallback: Replicate
REPLICATE_API_TOKEN=r8_...
VIDEO_MODEL_VERSION=your-model-version-here

# Fallback: Runway
RUNWAY_API_KEY=rw_...

# Session storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Authentication
NEXTAUTH_SECRET=change-me-to-a-random-string
NEXTAUTH_URL=http://localhost:3000

# Subscriptions / billing
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_ULTRA=price_...

# Content moderation
CONTENT_MODERATION_STRICT=true
